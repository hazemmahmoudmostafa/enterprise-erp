
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "erp-core-api",
  "main": "./src/index.ts",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "erp-core-db",
      "database_id": "111fb13a-27bc-4ab3-9b8d-7ffa76114987",
      "migrations_dir": "."
    }
  ]
}
